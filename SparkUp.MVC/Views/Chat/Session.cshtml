@model SparkUp.Business.SupportChatSession
@{
    ViewData["Title"] = "Chat - " + Model.Subject;
    Layout = "_Layout";
    var currentUserId = User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("ADMIN");
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Thông tin cuộc hội thoại</h6>
                </div>
                <div class="card-body">
                    <p><strong>Chủ đề:</strong> @Model.Subject</p>
                    <p><strong>Trạng thái:</strong> 
                        <span class="badge badge-@(Model.Status == "Open" ? "success" : Model.Status == "InProgress" ? "warning" : "secondary")">
                            @Model.Status
                        </span>
                    </p>
                    <p><strong>Khách hàng:</strong> @Model.Customer.FullName</p>
                    @if (Model.Admin != null)
                    {
                        <p><strong>Admin:</strong> @Model.Admin.FullName</p>
                    }
                    <p><strong>Bắt đầu:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    
                    @if (isAdmin && Model.Status != "Closed" && Model.Status != "Resolved")
                    {
                        <div class="mt-3">
                            @if (Model.AdminId == null)
                            {
                                <button class="btn btn-success btn-sm" onclick="assignToMe()">
                                    <i class="fas fa-user-check"></i> Nhận hỗ trợ
                                </button>
                            }
                            <button class="btn btn-warning btn-sm" onclick="updateStatus('Resolved')">
                                <i class="fas fa-check"></i> Đã giải quyết
                            </button>
                            <button class="btn btn-secondary btn-sm" onclick="updateStatus('Closed')">
                                <i class="fas fa-times"></i> Đóng
                            </button>
                        </div>
                    }
                    else if (!isAdmin && Model.Status != "Closed")
                    {
                        <div class="mt-3">
                            <button class="btn btn-secondary btn-sm" onclick="updateStatus('Closed')">
                                <i class="fas fa-times"></i> Đóng chat
                            </button>
                        </div>
                    }
                    
                    <div class="mt-3">
                        <a href="/Chat" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">@Model.Subject</h6>
                    <div>
                        @if (Model.IsCustomerOnline)
                        {
                            <span class="badge badge-success mr-2">
                                <i class="fas fa-circle"></i> Khách hàng online
                            </span>
                        }
                        @if (Model.IsAdminOnline && Model.AdminId.HasValue)
                        {
                            <span class="badge badge-success">
                                <i class="fas fa-circle"></i> Admin online
                            </span>
                        }
                    </div>
                </div>
                <div class="card-body p-0">
                    <div id="chatMessages" class="p-3" style="height: 500px; overflow-y: auto; background-color: #f8f9fa;">
                        @foreach (var message in Model.Messages.OrderBy(m => m.SentAt))
                        {
                            var isOwnMessage = message.SenderId.ToString() == currentUserId;
                            <div class="chat-message mb-3 @(isOwnMessage ? "text-right" : "text-left")">
                                <div class="d-inline-block p-3 rounded @(isOwnMessage ? "bg-primary text-white" : "bg-white border")">
                                    <div>@message.MessageText</div>
                                    <small class="d-block mt-1 @(isOwnMessage ? "text-light" : "text-muted")">
                                        @message.Sender.FullName - @message.SentAt.ToString("HH:mm")
                                    </small>
                                </div>
                            </div>
                        }
                    </div>
                    @if (Model.Status != "Closed" && Model.Status != "Resolved")
                    {
                        <div class="border-top p-3">
                            <div class="input-group">
                                <input type="text" id="messageInput" class="form-control" placeholder="Nhập tin nhắn..." 
                                       onkeypress="handleKeyPress(event)">
                                <div class="input-group-append">
                                    <button class="btn btn-primary" onclick="sendMessage()">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="border-top p-3 text-center text-muted">
                            <i class="fas fa-lock"></i> Cuộc hội thoại đã được @(Model.Status == "Closed" ? "đóng" : "giải quyết")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script>
        const sessionId = @Model.Id;
        const currentUserId = '@currentUserId';
        let connection = null;

        // SignalR connection
        function initializeSignalR() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .build();

            connection.start().then(function () {
                console.log("SignalR connected");
                // Join this chat session
                connection.invoke("JoinChatSession", sessionId.toString());
                // Update online status
                connection.invoke("UpdateOnlineStatus", sessionId.toString(), true);
            }).catch(function (err) {
                console.error(err.toString());
            });

            connection.on("ReceiveMessage", function (senderId, senderName, message, sentAt) {
                if (senderId !== currentUserId) {
                    appendMessage(senderId, senderName, message, sentAt, false);
                }
            });

            connection.on("AdminJoined", function (adminId, adminName) {
                appendSystemMessage("Admin " + adminName + " đã tham gia cuộc hội thoại");
                setTimeout(() => location.reload(), 1000); // Reload to update UI
            });

            connection.on("StatusUpdated", function (status) {
                appendSystemMessage("Trạng thái cuộc hội thoại đã được cập nhật: " + status);
                setTimeout(() => location.reload(), 1000); // Reload to update UI
            });

            connection.on("UpdateOnlineStatus", function (userId, userRole, isOnline) {
                // Update online status indicators
                console.log("User " + userId + " (" + userRole + ") is " + (isOnline ? "online" : "offline"));
            });
        }

        function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            
            if (!message) return;

            fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ 
                    sessionId: sessionId, 
                    messageText: message 
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    messageInput.value = '';
                    appendMessage(currentUserId, data.senderName, message, data.sentAt, true);
                }
            })
            .catch(error => console.error('Error:', error));
        }

        function handleKeyPress(event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        }

        function appendMessage(senderId, senderName, message, sentAt, isOwnMessage) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = `chat-message mb-3 ${isOwnMessage ? 'text-right' : 'text-left'}`;
            
            const time = new Date(sentAt).toLocaleTimeString('vi-VN', { 
                hour: '2-digit', 
                minute: '2-digit' 
            });
            
            messageDiv.innerHTML = `
                <div class="d-inline-block p-3 rounded ${isOwnMessage ? 'bg-primary text-white' : 'bg-white border'}">
                    <div>${message}</div>
                    <small class="d-block mt-1 ${isOwnMessage ? 'text-light' : 'text-muted'}">${senderName} - ${time}</small>
                </div>
            `;
            
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function appendSystemMessage(message) {
            const messagesContainer = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = 'text-center my-2';
            messageDiv.innerHTML = `<small class="text-muted bg-light px-2 py-1 rounded">${message}</small>`;
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function assignToMe() {
            fetch('/Chat/AssignAdmin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ sessionId: sessionId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => console.error('Error:', error));
        }

        function updateStatus(status) {
            const confirmMessage = status === 'Closed' ? 
                'Bạn có chắc chắn muốn đóng cuộc hội thoại này?' : 
                'Bạn có chắc chắn đã giải quyết xong vấn đề?';
                
            if (confirm(confirmMessage)) {
                fetch('/Chat/UpdateStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ 
                        sessionId: sessionId, 
                        status: status 
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    }
                })
                .catch(error => console.error('Error:', error));
            }
        }

        // Cleanup when leaving page
        window.addEventListener('beforeunload', function() {
            if (connection) {
                connection.invoke("LeaveChatSession", sessionId.toString());
                connection.invoke("UpdateOnlineStatus", sessionId.toString(), false);
            }
        });

        // Scroll to bottom on load
        document.addEventListener('DOMContentLoaded', function() {
            const messagesContainer = document.getElementById('chatMessages');
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            
            initializeSignalR();
        });
    </script>
}