@model SparkUp.MVC.Models.ChatRoomViewModel

@{
    ViewData["Title"] = "Chat - " + Model.TaskTitle;
    ViewData["BodyClass"] = "chat-page";
}

<div class="container-fluid chat-container">
    <div class="row chat-row">
        <!-- Mobile Sidebar Backdrop -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>        <!-- Chat Sidebar -->
        <div class="col-md-3 col-lg-3 d-none d-md-block chat-sidebar p-0" id="chatSidebar">
            <div class="chat-sidebar-header">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0"><i class="fas fa-comments me-2"></i>Cuộc trò chuyện</h5>
                        <small class="text-white-50">Tất cả các cuộc trò chuyện của bạn</small>
                    </div>
                    <!-- Close button for mobile -->
                    <button class="sidebar-close-btn d-md-none" id="closeSidebar" title="Đóng">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            
            <div class="chat-sidebar-search">
                <div class="input-group">
                    <input type="text" class="form-control" id="chatSearchInput" placeholder="Tìm kiếm cuộc trò chuyện...">
                    <button class="btn btn-primary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
            
            <div class="chat-rooms-list" id="chatRoomsList">
                <!-- Chat rooms will be loaded here -->
                <div class="loading-messages" id="loading-rooms">
                    <div class="loading-spinner"></div>
                    <div>Đang tải cuộc trò chuyện...</div>
                </div>
            </div>
        </div>

        <!-- Chat Main Area -->
        <div class="col-md-9 col-lg-9 col-12 chat-main p-0 d-flex flex-column">
            <!-- Chat Header -->
            <div class="chat-header">
                <div class="d-flex align-items-center">
                    <button class="btn btn-sm btn-light d-md-none me-3" id="toggleSidebar" title="Xem danh sách cuộc trò chuyện">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h5 class="mb-1 task-title">
                            <i class="fas fa-tasks me-2"></i>@Model.TaskTitle
                        </h5>
                        <div class="participants">
                            <i class="fas fa-users me-1"></i>
                            <span class="customer-name">@Model.CustomerName</span> 
                            <i class="fas fa-exchange-alt mx-2"></i> 
                            <span class="worker-name">@Model.WorkerName</span>
                            @if (!string.IsNullOrEmpty(Model.AdminName))
                            {
                                <span class="badge bg-warning ms-2">
                                    <i class="fas fa-user-shield me-1"></i>Admin: @Model.AdminName
                                </span>
                            }
                        </div>
                    </div>
                </div>                <div class="chat-actions">
                    <span class="badge @(Model.Status == ChatRoomStatus.Active ? "bg-success" : Model.Status == ChatRoomStatus.Disputed ? "bg-danger" : "bg-secondary")">
                        <i class="fas @(Model.Status == ChatRoomStatus.Active ? "fa-check-circle" : Model.Status == ChatRoomStatus.Disputed ? "fa-exclamation-triangle" : "fa-clock") me-1"></i>
                        @Model.Status.ToString()
                    </span>
                    @if (Model.Status == ChatRoomStatus.Active && Model.UserRole != "Admin")
                    {
                        <button class="btn btn-outline-light btn-sm ms-2" onclick="initiateDispute()">
                            <i class="fas fa-flag me-1"></i><span class="d-none d-sm-inline">Báo cáo</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Chat Messages Area -->
            <div class="chat-messages-container flex-grow-1">
                <!-- Chat status shows connection status and errors -->
                <div id="chat-status" class="chat-status-container" style="display: none;"></div>
                
                <!-- Dispute status information -->
                @if (Model.Status == ChatRoomStatus.Disputed)
                {
                    <div class="alert alert-warning m-3" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Phòng chat đang trong trạng thái tranh chấp</strong>
                        @if (!string.IsNullOrEmpty(Model.DisputeReason))
                        {
                            <div class="mt-2">
                                <small><strong>Lý do:</strong> @Model.DisputeReason</small>
                            </div>
                        }
                    </div>
                }
                
                <!-- Chat messages will appear here -->
                <div id="chat-messages" class="chat-messages">
                    <!-- Messages will be loaded here -->
                    <div class="loading-messages" id="loading-messages">
                        <div class="loading-spinner"></div>
                        <p class="mt-2">Đang tải tin nhắn...</p>
                    </div>
                </div>
            </div>

            <!-- Typing Indicator -->
            <div class="typing-indicator" id="typingIndicator">
                <i class="fas fa-circle"></i>
                <i class="fas fa-circle"></i>
                <i class="fas fa-circle"></i>
                <span id="typingText">Đang nhập tin nhắn...</span>
            </div>

            <!-- Chat Input Area -->
            <div class="chat-input-container">
                <div class="chat-input-group">
                    <div class="input-wrapper">
                        <input type="text" id="messageInput" class="form-control" 
                               placeholder="Nhập tin nhắn của bạn..." 
                               maxlength="1000"
                               disabled>
                    </div>
                    <button id="sendButton" class="btn btn-primary" disabled>
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
                <div class="char-count mt-2">
                    <small class="text-muted">
                        <span id="charCount">0</span>/1000 ký tự
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dispute Modal -->
<div class="modal fade" id="disputeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Report an Issue</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="disputeForm">
                    <div class="mb-3">
                        <label for="disputeReason" class="form-label">Please describe the issue:</label>
                        <textarea class="form-control" id="disputeReason" rows="4" 
                                placeholder="Describe what went wrong..." maxlength="500" required></textarea>
                        <div class="form-text">
                            Be specific about the issue. An administrator will review your report.
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="submitDispute()">Submit Report</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script>
        // Chat configuration
        window.chatConfig = {
            chatRoomId: @Model.Id,
            currentUserId: @(ViewContext.HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"),
            userRole: '@Model.UserRole',
            userName: '@ViewContext.HttpContext.User.Identity.Name'
        };
        
        // Debug info
        console.log('Chat config:', window.chatConfig);
    </script>
    <script src="~/js/chat-list.js"></script>
    <script src="~/js/chat.js"></script>
    
    <script>
        // Initialize everything when document is fully loaded
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM fully loaded, initializing chat components');
            
            // Safety check for missing elements
            if (!document.getElementById('chat-messages')) {
                console.error('Critical error: #chat-messages not found!');
                alert('Có lỗi khi tải giao diện chat. Vui lòng tải lại trang.');
            }
            
            if (!document.getElementById('messageInput')) {
                console.error('Critical error: #messageInput not found!');
            }
            
            if (!document.getElementById('sendButton')) {
                console.error('Critical error: #sendButton not found!');
            }
              // Global error handler
            window.addEventListener('error', function(event) {
                console.error('Global error:', event.error);
            });
            
            // Mobile sidebar handling
            setupMobileSidebar();
        });
        
        // Mobile sidebar toggle functionality
        function setupMobileSidebar() {
            const toggleBtn = document.getElementById('toggleSidebar');
            const closeBtn = document.getElementById('closeSidebar');
            const sidebar = document.getElementById('chatSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            
            function showSidebar() {
                sidebar.classList.add('show');
                backdrop.classList.add('show');
                document.body.style.overflow = 'hidden'; // Prevent background scroll
            }
            
            function hideSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
                document.body.style.overflow = ''; // Restore scroll
            }
            
            // Toggle sidebar when menu button is clicked
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    showSidebar();
                });
            }
            
            // Close sidebar when close button is clicked
            if (closeBtn) {
                closeBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    hideSidebar();
                });
            }
            
            // Close sidebar when backdrop is clicked
            if (backdrop) {
                backdrop.addEventListener('click', function(e) {
                    e.preventDefault();
                    hideSidebar();
                });
            }
            
            // Close sidebar on window resize if screen becomes larger
            window.addEventListener('resize', function() {
                if (window.innerWidth >= 768) {
                    hideSidebar();
                }
            });
            
            // Handle swipe gestures on mobile
            let startX = 0;
            let currentX = 0;
            let isSwipingLeft = false;
            
            sidebar.addEventListener('touchstart', function(e) {
                startX = e.touches[0].clientX;
                isSwipingLeft = false;
            });
            
            sidebar.addEventListener('touchmove', function(e) {
                currentX = e.touches[0].clientX;
                const diffX = startX - currentX;
                
                if (diffX > 50) { // Swipe left threshold
                    isSwipingLeft = true;
                }
            });
            
            sidebar.addEventListener('touchend', function(e) {
                if (isSwipingLeft) {
                    hideSidebar();
                }
                isSwipingLeft = false;
            });
        }
        
        // Functions for dispute handling
        function initiateDispute() {
            const disputeModal = new bootstrap.Modal(document.getElementById('disputeModal'));
            disputeModal.show();
        }
        
        function submitDispute() {
            const reason = document.getElementById('disputeReason').value.trim();
            if (!reason) {
                alert('Please provide a reason for the dispute.');
                return;
            }
            
            fetch('/Chat/InitiateDispute', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    chatRoomId: window.chatConfig.chatRoomId,
                    reason: reason
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Your dispute has been submitted. An administrator will review it shortly.');
                    const disputeModal = bootstrap.Modal.getInstance(document.getElementById('disputeModal'));
                    disputeModal.hide();
                    location.reload();
                } else {
                    alert('Failed to submit dispute. Please try again.');
                }
            })
            .catch(error => {
                console.error('Error submitting dispute:', error);
                alert('An error occurred while submitting your dispute. Please try again.');
            });
        }
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/improved-chat.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}
